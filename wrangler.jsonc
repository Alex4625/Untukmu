{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "untukmu-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-02-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "untukmu-db",
      "database_id": "1deefcbc-4ed9-43b1-aa8e-e9a2e353b227",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "untukmu-media"
    }
  ]
}
